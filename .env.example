# Gemini is optional. Without a key, ClaimReady uses its deterministic local
# parser (best for the supplied synthetic claim packet).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# Set to false to force local parsing, even when a key is present.
USE_VISION_LLM=true
MAX_UPLOAD_MB=20

# Optional alternative provider. Set LLM_PROVIDER=openai to use these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
